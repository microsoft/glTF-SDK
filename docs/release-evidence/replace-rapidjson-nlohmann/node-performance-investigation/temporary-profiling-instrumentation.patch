+namespace
+{
+    using Clock = std::chrono::steady_clock;
+    using OrderedJson = Internal::JsonValue;
+    using OrderedAdapter =
+        valijson::adapters::NlohmannJsonAdapter;
+    using IndexedOrderedAdapter =
+        valijson::adapters::T39IndexedJsonAdapter;
+    using DefaultJson =
+        valijson::adapters::T39DefaultJson;
+    using DefaultAdapter =
+        valijson::adapters::T39DefaultJsonAdapter;
+
+    volatile std::size_t g_sink = 0U;
+
