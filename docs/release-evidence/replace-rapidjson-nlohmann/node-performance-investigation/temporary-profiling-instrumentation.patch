+ * T39DefaultJson value, assumed to be an array, so there is very little overhead
+ * associated with copy construction and passing by value.
+ */
+template <class ValueType>
+class T39DefaultJsonArray
+{
+public:
+
+    typedef T39DefaultJsonArrayValueIterator<ValueType> const_iterator;
+    typedef T39DefaultJsonArrayValueIterator<ValueType> iterator;
