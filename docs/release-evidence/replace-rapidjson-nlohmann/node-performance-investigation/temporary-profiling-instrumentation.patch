+ * @see FrozenValue
+ */
+class T39DefaultJsonFrozenValue: public FrozenValue
+{
+public:
+
+    /**
+     * @brief  Make a copy of a T39DefaultJson value
+     *
+     * @param  source  the T39DefaultJson value to be copied
+     */
+    explicit T39DefaultJsonFrozenValue(T39DefaultJson source)
+      : m_value(std::move(source)) { }
