+/**
+ * @brief   Light weight wrapper for a T39DefaultJson value.
+ *
+ * This class is passed as an argument to the BasicAdapter template class,
+ * and is used to provide access to a T39DefaultJson value. This class is responsible
+ * for the mechanics of actually reading a T39DefaultJson value, whereas the
+ * BasicAdapter class is responsible for the semantics of type comparisons
+ * and conversions.
+ *
+ * The functions that need to be provided by this class are defined implicitly
+ * by the implementation of the BasicAdapter template class.
+ *
+ * @see BasicAdapter
+ */
+template<class ValueType>
+class T39DefaultJsonValue
+{
+public:
+
+    /// Construct a wrapper for the empty object singleton
+    T39DefaultJsonValue()
+      : m_value(emptyObject()) { }
+
+    /// Construct a wrapper for a specific T39DefaultJson value
+    T39DefaultJsonValue(const T39DefaultJson &value)
+      : m_value(value) { }
+
+    /**
+     * @brief   Create a new T39DefaultJsonFrozenValue instance that contains the
+     *          value referenced by this T39DefaultJsonValue instance.
+     *
+     * @returns pointer to a new T39DefaultJsonFrozenValue instance, belonging to the
+     *          caller.
+     */
+    FrozenValue * freeze() const
+    {
+        return new T39DefaultJsonFrozenValue(m_value);
+    }
+
+    /**
+     * @brief   Optionally return a T39DefaultJsonArray instance.
+     *
+     * If the referenced T39DefaultJson value is an array, this function will return
+     * a std::optional containing a T39DefaultJsonArray instance referencing the
+     * array.
+     *
+     * Otherwise it will return an empty optional.
+     */
+    opt::optional<T39DefaultJsonArray<ValueType>> getArrayOptional() const
+    {
+        if (m_value.is_array()) {
+            return opt::make_optional(T39DefaultJsonArray<ValueType>(m_value));
+        }
+
+        return {};
+    }
+
+    /**
+     * @brief   Retrieve the number of elements in the array
+     *
+     * If the referenced T39DefaultJson value is an array, this function will
+     * retrieve the number of elements in the array and store it in the output
+     * variable provided.
+     *
+     * @param   result  reference to size_t to set with result
+     *
+     * @returns true if the number of elements was retrieved, false otherwise.
+     */
+    bool getArraySize(size_t &result) const
+    {
+        if (m_value.is_array()) {
+            result = m_value.size();
+            return true;
+        }
+
+        return false;
+    }
+
+    bool getBool(bool &result) const
+    {
+        if (m_value.is_boolean()) {
+            result = m_value.get<bool>();
+            return true;
+        }
+
+        return false;
+    }
+
+    bool getDouble(double &result) const
+    {
+        if (m_value.is_number_float()) {
+            result = m_value.get<double>();
+            return true;
+        }
+
+        return false;
+    }
+
+    bool getInteger(int64_t &result) const
+    {
+        if(m_value.is_number_integer()) {
+            result = m_value.get<int64_t>();
+            return true;
+        }
+        return false;
+    }
+
+    /**
+     * @brief   Optionally return a T39DefaultJsonObject instance.
+     *
+     * If the referenced T39DefaultJson value is an object, this function will return a
+     * std::optional containing a T39DefaultJsonObject instance referencing the
+     * object.
+     *
+     * Otherwise it will return an empty optional.
+     */
+    opt::optional<T39DefaultJsonObject> getObjectOptional() const;
+
+    /**
+     * @brief   Retrieve the number of members in the object
+     *
+     * If the referenced T39DefaultJson value is an object, this function will
+     * retrieve the number of members in the object and store it in the output
+     * variable provided.
+     *
+     * @param   result  reference to size_t to set with result
+     *
+     * @returns true if the number of members was retrieved, false otherwise.
+     */
+    bool getObjectSize(size_t &result) const
+    {
+        if (m_value.is_object()) {
+            result = m_value.size();
+            return true;
+        }
+
+        return false;
+    }
+
+    bool getString(std::string &result) const
+    {
+        if (m_value.is_string()) {
+            result = m_value.get<std::string>();
+            Microsoft::glTF::Internal::T39CountAdapterStringCopy(
+                result.size());
+            return true;
+        }
+
+        return false;
+    }
+
+    static bool hasStrictTypes()
+    {
+        return true;
+    }
+
+    bool isArray() const
+    {
+        return m_value.is_array();
+    }
+
+    bool isBool() const
+    {
+        return m_value.is_boolean();
+    }
+
+    bool isDouble() const
+    {
+        return m_value.is_number_float();
+    }
+
+    bool isInteger() const
+    {
+        return m_value.is_number_integer();
+    }
+
+    bool isNull() const
+    {
+        return m_value.is_null();
+    }
+
+    bool isNumber() const
+    {
+        return m_value.is_number();
+    }
+
+    bool isObject() const
+    {
+        return m_value.is_object();
+    }
+
+    bool isString() const
+    {
+        return m_value.is_string();
+    }
+
+private:
+
+    /// Return a reference to an empty object singleton
+    static const T39DefaultJson & emptyObject()
+    {
+        static const T39DefaultJson object = T39DefaultJson::object();
+        return object;
+    }
+
+    /// Reference to the contained T39DefaultJson value.
+    const T39DefaultJson &m_value;
+};
+
+/**
+ * @brief   An implementation of the Adapter interface supporting T39DefaultJson.
+ *
+ * This class is defined in terms of the BasicAdapter template class, which
+ * helps to ensure that all of the Adapter implementations behave consistently.
+ *
+ * @see Adapter
+ * @see BasicAdapter
+ */
+class T39DefaultJsonAdapter
+    : public BasicAdapter<T39DefaultJsonAdapter,
+                          T39DefaultJsonArray<T39DefaultJsonAdapter>,
+                          T39DefaultJsonObjectMember, T39DefaultJsonObject,
+                          T39DefaultJsonValue<T39DefaultJsonAdapter>>
+{
+public:
+    /// Construct a T39DefaultJsonAdapter that contains an empty object
+    T39DefaultJsonAdapter()
+      : BasicAdapter() { }
+
+    /// Construct a T39DefaultJsonAdapter containing a specific Nlohmann Json
+    /// object
+    T39DefaultJsonAdapter(const T39DefaultJson &value)
+        : BasicAdapter(T39DefaultJsonValue<T39DefaultJsonAdapter>{value})
+    {
+        Microsoft::glTF::Internal::T39CountAdapterConstruction();
+    }
+};
+
+template <class ValueType>
+opt::optional<T39DefaultJsonObject>
+T39DefaultJsonValue<ValueType>::getObjectOptional() const
+{
+    if (m_value.is_object()) {
+        return opt::make_optional(T39DefaultJsonObject(m_value));
+    }
+
+    return {};
+}
+
+/// Specialisation of the AdapterTraits template struct for T39DefaultJsonAdapter.
+template<>
+struct AdapterTraits<valijson::adapters::T39DefaultJsonAdapter>
+{
+    typedef T39DefaultJson DocumentType;
+
+    static std::string adapterName()
+    {
+        return "T39DefaultJsonAdapter";
+    }
+};
+
+inline bool T39DefaultJsonFrozenValue::equalTo(const Adapter &other, bool strict) const
+{
+    return T39DefaultJsonAdapter(m_value).equalTo(other, strict);
+}
+
+
+inline T39DefaultJsonObjectMemberIterator<T39DefaultJsonObjectMember>
+T39DefaultJsonObject::begin() const
+{
+    return m_value.begin();
+}
+
+inline T39DefaultJsonObjectMemberIterator<T39DefaultJsonObjectMember>
+T39DefaultJsonObject::end() const
+{
+    return m_value.end();
+}
+
+inline T39DefaultJsonObjectMemberIterator<T39DefaultJsonObjectMember>
+T39DefaultJsonObject::find(
+        const std::string &propertyName) const
+{
+    const auto found = m_value.find(propertyName);
+    Microsoft::glTF::Internal::T39CountAdapterFind(
+        found == m_value.end() ? 0U : 1U);
+    return found;
+}
