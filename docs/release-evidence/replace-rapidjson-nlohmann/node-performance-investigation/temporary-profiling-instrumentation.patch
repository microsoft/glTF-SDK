+                    ++counters->constraintEvaluations;
+                }
+            }
+
+            inline void T39CountAllOf()
+            {
+                auto* counters = T39ActiveCounters();
+                if (counters != nullptr)
+                {
+                    ++counters->allOfEvaluations;
+                }
+            }
+
+            inline void T39CountAnyOf()
+            {
+                auto* counters = T39ActiveCounters();
+                if (counters != nullptr)
+                {
+                    ++counters->anyOfEvaluations;
+                }
+            }
+
+            inline void T39CountOneOf()
