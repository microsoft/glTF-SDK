+    Options ParseOptions(int argc, char** argv)
+    {
+        Options options;
+        for (int i = 1; i < argc; ++i)
+        {
+            const std::string argument = argv[i];
+            const auto requireValue =
+                [&](const char* name) -> std::string
+            {
+                if (++i >= argc)
+                {
+                    throw std::runtime_error(
+                        std::string("Missing value for ") + name);
+                }
+                return argv[i];
+            };
+
+            if (argument == "--assets")
+            {
+                options.assetRoot = requireValue("--assets");
+            }
+            else if (argument == "--case")
+            {
+                options.caseId = requireValue("--case");
+            }
+            else if (argument == "--variant")
+            {
+                options.variant = requireValue("--variant");
+            }
+            else if (argument == "--output")
+            {
+                options.outputPath = requireValue("--output");
+            }
+            else if (argument == "--output-root")
+            {
+                options.outputRoot = requireValue("--output-root");
+            }
+            else if (argument == "--warmups")
+            {
+                options.warmups = static_cast<std::size_t>(
+                    std::stoull(requireValue("--warmups")));
+            }
+            else if (argument == "--samples")
+            {
+                options.samples = static_cast<std::size_t>(
+                    std::stoull(requireValue("--samples")));
+            }
+            else if (argument == "--count-operations")
+            {
+                options.countOperations = true;
+            }
+            else if (argument == "--include-serialization")
+            {
+                options.includeSerialization = true;
+            }
+            else
+            {
+                throw std::runtime_error(
+                    "Unknown argument " + argument);
+            }
+        }
+
+        if (options.assetRoot.empty() ||
+            options.caseId.empty() ||
+            options.variant.empty() ||
+            options.outputPath.empty())
+        {
+            throw std::runtime_error(
+                "--assets, --case, --variant, and --output are required");
+        }
+        if (options.includeSerialization &&
+            options.outputRoot.empty())
+        {
+            throw std::runtime_error(
+                "--output-root is required with --include-serialization");
+        }
+        if (options.samples == 0U)
+        {
+            throw std::runtime_error("--samples must be non-zero");
+        }
+        return options;
+    }
+
+    template<typename Json, typename Adapter>
+    std::unique_ptr<CompiledSchema<Json, Adapter>>
+    CompileSchema(bool disableRoot)
+    {
+        auto compiled =
+            std::unique_ptr<CompiledSchema<Json, Adapter>>(
+                new CompiledSchema<Json, Adapter>(disableRoot));
+        Json* root = const_cast<Json*>(
+            compiled->provider->GetDocument(SCHEMA_URI_GLTF));
+        if (root->is_object() &&
+            root->find("id") == root->end())
+        {
+            root->emplace("id", SCHEMA_URI_GLTF);
+        }
+
+        valijson::SchemaParser parser(
+            valijson::SchemaParser::kDraft4);
+        Internal::T39PhaseScope phase(
+            Internal::T39Phase::SchemaPopulate);
+        Internal::T39DomainScope domain(
+            Internal::T39Domain::SchemaPopulation);
+        parser.populateSchema(
+            Adapter(*root),
+            compiled->schema,
+            [&compiled](const std::string& uri)
+            {
+                return compiled->provider->GetDocument(uri);
+            },
+            [](const Json*)
+            {
+            });
+        return compiled;
+    }
+
+    template<typename Json, typename Adapter>
+    bool Validate(
+        const CompiledSchema<Json, Adapter>& compiled,
+        const Json& document,
+        ValidationMode mode)
+    {
+        Internal::T39PhaseScope phase(
+            Internal::T39Phase::DocumentValidate);
+        Internal::T39DomainScope domain(
+            Internal::T39Domain::Validation);
+
+        if (mode == ValidationMode::Exhaustive)
+        {
+            valijson::ValidationResults results;
+            valijson::Validator validator(
+                valijson::Validator::kStrongTypes,
+                valijson::Validator::kStrictDateTime);
+            return validator.validate(
+                compiled.schema,
+                Adapter(document),
+                &results);
+        }
+
+        valijson::Validator fastValidator(
+            valijson::Validator::kStrongTypes,
+            valijson::Validator::kStrictDateTime);
+        if (fastValidator.validate(
+                compiled.schema,
+                Adapter(document),
+                nullptr))
+        {
+            return true;
+        }
+        if (mode == ValidationMode::Fast)
+        {
+            return false;
+        }
+
+        valijson::ValidationResults results;
+        valijson::Validator diagnosticValidator(
+            valijson::Validator::kStrongTypes,
+            valijson::Validator::kStrictDateTime);
+        return diagnosticValidator.validate(
+            compiled.schema,
+            Adapter(document),
+            &results);
+    }
+
+    LoadedInput ReadInput(
+        const Options& options,
+        const AssetCase& asset)
+    {
+        const auto relativeDirectory =
+            GetDirectoryName(asset.relativePath);
+        const auto sourceDirectory =
+            FileStreamReader::JoinPath(
+                options.assetRoot,
+                relativeDirectory);
+        const auto sourceFileName =
+            GetFileName(asset.relativePath);
+
+        LoadedInput input;
+        input.streamReader =
+            std::make_shared<FileStreamReader>(
+                sourceDirectory);
+        input.sourceStream =
+            input.streamReader->GetInputStream(sourceFileName);
+        input.sourceStream->seekg(0, std::ios::end);
+        input.sourceBytes = static_cast<std::uint64_t>(
+            input.sourceStream->tellg());
+        input.sourceStream->seekg(0, std::ios::beg);
+        return input;
+    }
+
+    template<typename TReader>
+    std::vector<std::uint8_t> ReadWholeBuffer(
+        const TReader& reader,
+        const Document& document,
+        const Buffer& buffer)
+    {
+        BufferView wholeBuffer;
+        wholeBuffer.bufferId = buffer.id;
+        wholeBuffer.byteOffset = 0U;
+        wholeBuffer.byteLength = buffer.byteLength;
+        return reader.template ReadBinaryData<std::uint8_t>(
+            document,
+            wholeBuffer);
+    }
+
+    void ReadBuffers(
+        const GLBResourceReader& reader,
+        const Document& document,
+        LoadedResources& resources)
+    {
+        resources.buffers.reserve(document.buffers.Size());
+        for (const auto& buffer : document.buffers.Elements())
+        {
+            auto bytes = ReadWholeBuffer(
+                reader,
+                document,
+                buffer);
+            resources.bufferBytes += bytes.size();
+            resources.buffers.push_back(std::move(bytes));
+        }
+    }
+
+    void ReadImages(
+        const GLBResourceReader& reader,
+        const Document& document,
+        LoadedResources& resources)
+    {
+        resources.images.reserve(document.images.Size());
+        for (const auto& image : document.images.Elements())
+        {
+            auto bytes = reader.ReadBinaryData(document, image);
+            resources.imageBytes += bytes.size();
+            resources.images.push_back(std::move(bytes));
+        }
+        resources.bytes =
+            resources.bufferBytes +
+            resources.imageBytes;
+    }
+
+    void ValidateDocumentShape(
+        const Document& document,
+        const AssetCase& asset)
+    {
+        if (document.nodes.Size() != asset.expectedNodes ||
+            document.meshes.Size() != asset.expectedMeshes ||
+            document.materials.Size() != asset.expectedMaterials ||
+            document.accessors.Size() != asset.expectedAccessors)
+        {
+            throw std::runtime_error(
+                "Document structural counts differ from expectation");
+        }
+
+        if (asset.id.find("NodePerformance") == 0U &&
+            document.extensionsUsed.find("KHR_lights_punctual") ==
+                document.extensionsUsed.end())
+        {
+            throw std::runtime_error(
+                "KHR_lights_punctual was not preserved");
+        }
+    }
+
+    void WriteGlb(
+        const Options& options,
+        const AssetCase& asset,
+        std::size_t sample,
+        const Document& document,
+        const LoadedResources& resources,
+        const std::string& manifest)
+    {
+        const std::string fileName =
+            asset.id + "-" + options.variant + "-" +
+            std::to_string(sample) + ".glb";
+        std::shared_ptr<const IStreamWriter> streamWriter =
+            std::make_shared<FileStreamWriter>(
+                options.outputRoot);
+        GLBResourceWriter writer(streamWriter);
+
+        bool wroteBinaryChunk = false;
+        for (std::size_t i = 0U;
+             i < resources.buffers.size();
+             ++i)
+        {
+            const auto& buffer = document.buffers[i];
+            if (buffer.uri.empty() ||
+                buffer.uri == EMPTY_URI)
+            {
+                if (wroteBinaryChunk)
+                {
+                    throw std::runtime_error(
+                        "More than one GLB binary buffer");
+                }
+                BufferView wholeBuffer;
+                wholeBuffer.bufferId = GLB_BUFFER_ID;
+                wholeBuffer.byteOffset = 0U;
+                wholeBuffer.byteLength =
+                    resources.buffers[i].size();
+                writer.Write(
+                    wholeBuffer,
+                    resources.buffers[i]);
+                wroteBinaryChunk = true;
+            }
+            else
+            {
+                writer.WriteExternal(
+                    buffer.uri,
+                    resources.buffers[i]);
+            }
+        }
+
+        writer.Flush(manifest, fileName);
+        Consume(resources.bytes + manifest.size());
+    }
+
+    template<typename ValidationJson>
+    const ValidationJson* PrepareValidationDocument(
+        const std::string& json,
+        const OrderedJson& ordered,
+        std::unique_ptr<ValidationJson>& owned,
+        std::true_type)
+    {
+        (void)json;
+        (void)owned;
+        return &ordered;
+    }
+
+    template<typename ValidationJson>
+    const ValidationJson* PrepareValidationDocument(
+        const std::string& json,
+        const OrderedJson& ordered,
+        std::unique_ptr<ValidationJson>& owned,
+        std::false_type)
+    {
+        (void)ordered;
+        owned.reset(new ValidationJson(
+            ValidationJson::parse(
+                json.begin(),
+                json.end(),
+                nullptr,
+                true,
+                false)));
+        return owned.get();
+    }
+
+    template<typename ValidationJson, typename Adapter>
+    Row RunOne(
+        const Options& options,
+        const AssetCase& asset,
+        ParseMode parseMode,
+        ValidationMode validationMode,
+        bool disableRoot,
+        bool optimizeScalarUniqueItems,
+        CompiledSchema<ValidationJson, Adapter>* cachedSchema,
+        double cacheSetupUs,
+        std::size_t sample,
+        bool warmup)
+    {
+        Row row;
+        row.variant = options.variant;
+        row.caseId = asset.id;
+        row.sample = sample;
+        row.warmup = warmup;
+        row.cacheSetupUs = cacheSetupUs;
+        row.profile.recordTimings = true;
+        row.profile.countOperations =
+            options.countOperations;
+        row.profile.optimizeScalarUniqueItems =
+            optimizeScalarUniqueItems;
+        Internal::T39ProfileScope profile(row.profile);
+
+        const auto totalStart = Clock::now();
+        LoadedInput input;
+        row.fileOpenUs = Measure([&]()
+        {
+            input = ReadInput(options, asset);
+        });
+        row.jsonChunkUs = Measure([&]()
+        {
+            input.resourceReader.reset(new GLBResourceReader(
+                input.streamReader,
+                input.sourceStream));
+        });
+        row.fileJsonUs =
+            row.fileOpenUs +
+            row.jsonChunkUs;
+        row.inputBytes = input.sourceBytes;
+        row.jsonBytes =
+            input.resourceReader->GetJson().size();
+        row.afterInput = GetMemorySnapshot();
+
+        OrderedJson ordered;
+        row.strictParseUs = Measure([&]()
+        {
+            ordered = ParseOrdered(
+                input.resourceReader->GetJson(),
+                parseMode);
+        });
+        row.afterParse = GetMemorySnapshot();
+
+        std::unique_ptr<ValidationJson>
+            validationDocumentStorage;
+        const ValidationJson* validationDocument = nullptr;
+        row.validationDomUs = Measure([&]()
+        {
+            validationDocument =
+                PrepareValidationDocument<ValidationJson>(
+                    input.resourceReader->GetJson(),
+                    ordered,
+                    validationDocumentStorage,
+                    typename std::is_same<
+                        ValidationJson,
+                        OrderedJson>::type());
+        });
+        row.afterValidationDom = GetMemorySnapshot();
+
+        std::unique_ptr<
+            CompiledSchema<ValidationJson, Adapter>>
+            perLoadSchema;
+        CompiledSchema<ValidationJson, Adapter>* compiled =
+            cachedSchema;
+        if (compiled == nullptr)
+        {
+            row.schemaCompileUs = Measure([&]()
+            {
+                perLoadSchema =
+                    CompileSchema<ValidationJson, Adapter>(
+                        disableRoot);
+            });
+            compiled = perLoadSchema.get();
+        }
+        row.afterSchema = GetMemorySnapshot();
+
+        bool valid = false;
+        row.validateUs = Measure([&]()
+        {
+            valid = Validate<ValidationJson, Adapter>(
+                *compiled,
+                *validationDocument,
+                validationMode);
+        });
+        if (!valid)
+        {
+            throw std::runtime_error(
+                "Validation rejected a valid corpus asset");
+        }
+        row.afterValidation = GetMemorySnapshot();
+
+        Document document;
+        row.typedUs = Measure([&]()
+        {
+            document = Internal::T39ConstructDocument(
+                ordered,
+                KHR::GetKHRExtensionDeserializer());
+        });
+        ValidateDocumentShape(document, asset);
+        row.afterTyped = GetMemorySnapshot();
+
+        LoadedResources resources;
+        row.bufferReadUs = Measure([&]()
+        {
+            ReadBuffers(
+                *input.resourceReader,
+                document,
+                resources);
+        });
+        row.imageReadUs = Measure([&]()
+        {
+            ReadImages(
+                *input.resourceReader,
+                document,
+                resources);
+        });
+        row.resourcesUs =
+            row.bufferReadUs +
+            row.imageReadUs;
+        row.resourceBytes = resources.bytes;
+        row.bufferBytes = resources.bufferBytes;
+        row.imageBytes = resources.imageBytes;
+        row.afterResources = GetMemorySnapshot();
+
+        row.totalLoadUs =
+            std::chrono::duration<double, std::micro>(
+                Clock::now() - totalStart).count();
+
+        if (options.includeSerialization)
+        {
+            OrderedJson serializedDom;
+            row.serializerDomUs = Measure([&]()
+            {
+                serializedDom =
+                    Internal::T39CreateJsonDocument(
+                        document,
+                        KHR::GetKHRExtensionSerializer());
+            });
+
+            std::string manifest;
+            row.serializerTextUs = Measure([&]()
+            {
+                Internal::T39PhaseScope phase(
+                    Internal::T39Phase::SerializerText);
+                Internal::T39DomainScope domain(
+                    Internal::T39Domain::Serialization);
+                manifest = Internal::WriteJson(
+                    serializedDom);
+            });
+
+            row.resourceWriteUs = Measure([&]()
+            {
+                WriteGlb(
+                    options,
+                    asset,
+                    sample,
+                    document,
+                    resources,
+                    manifest);
+            });
+            row.afterSerialization =
+                GetMemorySnapshot();
+        }
+
+        Consume(
+            document.nodes.Size() +
+            document.meshes.Size() +
+            document.accessors.Size() +
+            resources.bytes);
+        return row;
+    }
+
+    template<typename ValidationJson, typename Adapter>
+    std::vector<Row> RunTypedVariant(
+        const Options& options,
+        const AssetCase& asset,
+        ParseMode parseMode,
+        ValidationMode validationMode,
+        bool disableRoot,
+        bool cacheSchema,
+        bool optimizeScalarUniqueItems = false)
+    {
+        std::unique_ptr<
+            CompiledSchema<ValidationJson, Adapter>> cached;
+        double cacheSetupUs = 0.0;
+        if (cacheSchema)
+        {
+            Internal::T39ProfileState setupState;
+            Internal::T39ProfileScope setupProfile(
+                setupState);
+            cacheSetupUs = Measure([&]()
+            {
+                cached =
+                    CompileSchema<ValidationJson, Adapter>(
+                        disableRoot);
+            });
+        }
+
+        for (std::size_t warmup = 0U;
+             warmup < options.warmups;
+             ++warmup)
+        {
+            RunOne<ValidationJson, Adapter>(
+                options,
+                asset,
+                parseMode,
+                validationMode,
+                disableRoot,
+                optimizeScalarUniqueItems,
+                cached.get(),
+                cacheSetupUs,
+                warmup,
+                true);
+        }
+
+        std::vector<Row> rows;
+        rows.reserve(options.samples);
+        for (std::size_t sample = 0U;
+             sample < options.samples;
+             ++sample)
+        {
+            rows.push_back(
+                RunOne<ValidationJson, Adapter>(
+                    options,
+                    asset,
+                    parseMode,
+                    validationMode,
+                    disableRoot,
+                    optimizeScalarUniqueItems,
+                    cached.get(),
+                    cacheSetupUs,
+                    sample,
+                    false));
+        }
+        return rows;
+    }
+
+    std::vector<Row> RunVariant(
+        const Options& options,
+        const AssetCase& asset)
+    {
+        if (options.variant == "current")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                OrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::CallbackStrict,
+                    ValidationMode::Exhaustive,
+                    false,
+                    false);
+        }
+        if (options.variant == "disable-root")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                OrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::CallbackStrict,
+                    ValidationMode::Exhaustive,
+                    true,
+                    false);
+        }
+        if (options.variant == "sax-disable-root")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                OrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::SaxStrict,
+                    ValidationMode::Exhaustive,
+                    true,
+                    false);
+        }
+        if (options.variant == "ordered-fast")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                OrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::CallbackStrict,
+                    ValidationMode::Fast,
+                    false,
+                    false);
+        }
+        if (options.variant == "ordered-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                OrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::CallbackStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    false);
+        }
+        if (options.variant == "plain-ordered-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                OrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::Plain,
+                    ValidationMode::Fallback,
+                    false,
+                    false);
+        }
+        if (options.variant == "sax-ordered-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                OrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::SaxStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    false);
+        }
+        if (options.variant ==
+            "sax-scalar-unique-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                OrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::SaxStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    false,
+                    true);
+        }
+        if (options.variant == "cached-ordered-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                OrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::CallbackStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    true);
+        }
+        if (options.variant ==
+            "cached-sax-ordered-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                OrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::SaxStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    true);
+        }
+        if (options.variant ==
+            "cached-sax-scalar-unique-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                OrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::SaxStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    true,
+                    true);
+        }
+        if (options.variant == "indexed-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                IndexedOrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::CallbackStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    false);
+        }
+        if (options.variant ==
+            "cached-indexed-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                IndexedOrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::CallbackStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    true);
+        }
+        if (options.variant == "sax-indexed-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                IndexedOrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::SaxStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    false);
+        }
+        if (options.variant ==
+            "sax-indexed-scalar-unique-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                IndexedOrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::SaxStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    false,
+                    true);
+        }
+        if (options.variant ==
+            "cached-sax-indexed-fallback")
+        {
+            return RunTypedVariant<
+                OrderedJson,
+                IndexedOrderedAdapter>(
+                    options,
+                    asset,
+                    ParseMode::SaxStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    true);
+        }
+        if (options.variant == "default-fallback")
+        {
+            return RunTypedVariant<
+                DefaultJson,
+                DefaultAdapter>(
+                    options,
+                    asset,
+                    ParseMode::CallbackStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    false);
+        }
+        if (options.variant ==
+            "cached-default-fallback")
+        {
+            return RunTypedVariant<
+                DefaultJson,
+                DefaultAdapter>(
+                    options,
+                    asset,
+                    ParseMode::CallbackStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    true);
+        }
+        if (options.variant == "sax-default-fallback")
+        {
+            return RunTypedVariant<
+                DefaultJson,
+                DefaultAdapter>(
+                    options,
+                    asset,
+                    ParseMode::SaxStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    false);
+        }
+        if (options.variant ==
+            "sax-default-scalar-unique-fallback")
+        {
+            return RunTypedVariant<
+                DefaultJson,
+                DefaultAdapter>(
+                    options,
+                    asset,
+                    ParseMode::SaxStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    false,
+                    true);
+        }
+        if (options.variant ==
+            "cached-sax-default-fallback")
+        {
+            return RunTypedVariant<
+                DefaultJson,
+                DefaultAdapter>(
+                    options,
+                    asset,
+                    ParseMode::SaxStrict,
+                    ValidationMode::Fallback,
+                    false,
+                    true);
+        }
+
+        throw std::runtime_error(
+            "Unknown variant " + options.variant);
+    }
+
+    std::string EscapeCsv(const std::string& value)
+    {
+        if (value.find_first_of(",\"\r\n") ==
+            std::string::npos)
+        {
+            return value;
+        }
+
+        std::string escaped = "\"";
+        for (const char character : value)
+        {
+            escaped += character == '"'
+                ? "\"\""
+                : std::string(1U, character);
+        }
+        escaped += '"';
+        return escaped;
+    }
+
+    const Internal::T39DomainCounters& Domain(
+        const Row& row,
+        Internal::T39Domain domain)
+    {
+        return row.profile.counters[
+            static_cast<std::size_t>(domain)];
+    }
+
+    double Phase(
+        const Row& row,
+        Internal::T39Phase phase)
+    {
+        return row.profile.phaseMicroseconds[
+            static_cast<std::size_t>(phase)];
+    }
+
+    void WriteMemory(
+        std::ostream& output,
+        const MemorySnapshot& memory)
+    {
+        output
+            << ',' << memory.workingSet
+            << ',' << memory.privateBytes
+            << ',' << memory.peakWorkingSet;
+    }
+
+    void WriteRows(
+        const Options& options,
+        const std::vector<Row>& rows)
+    {
+        std::ofstream output(
+            options.outputPath,
+            std::ios::binary | std::ios::trunc);
+        if (!output)
+        {
+            throw std::runtime_error(
+                "Unable to create " + options.outputPath);
+        }
+        output.precision(17);
+        output
+            << "variant,case_id,sample,warmup,total_load_us,"
+            << "file_json_us,file_open_us,json_chunk_us,"
+            << "strict_parse_us,validation_dom_us,"
+            << "schema_compile_us,schema_locate_us,schema_parse_us,"
+            << "schema_populate_us,validate_us,typed_us,resources_us,"
+            << "accessors_us,animations_us,buffers_us,buffer_views_us,"
+            << "cameras_us,images_us,materials_us,meshes_us,nodes_us,"
+            << "samplers_us,scenes_us,skins_us,textures_us,typed_other_us,"
+            << "serializer_dom_us,serializer_text_us,resource_write_us,"
+            << "cache_setup_us,input_bytes,json_bytes,resource_bytes,"
+            << "buffer_read_us,image_read_us,buffer_bytes,image_bytes,"
+            << "after_input_ws,after_input_private,after_input_peak,"
+            << "after_parse_ws,after_parse_private,after_parse_peak,"
+            << "after_validation_dom_ws,after_validation_dom_private,"
+            << "after_validation_dom_peak,after_schema_ws,"
+            << "after_schema_private,after_schema_peak,"
+            << "after_validation_ws,after_validation_private,"
+            << "after_validation_peak,after_typed_ws,after_typed_private,"
+            << "after_typed_peak,after_resources_ws,"
+            << "after_resources_private,after_resources_peak,"
+            << "after_serialization_ws,after_serialization_private,"
+            << "after_serialization_peak,schema_locator_calls,"
+            << "schema_documents_parsed,schema_bytes_parsed,"
+            << "parser_parent_scan_loops,parser_parent_scan_elements,"
+            << "schema_adapter_find_calls,schema_adapter_find_scans,"
+            << "schema_adapter_members,schema_adapter_constructions,"
+            << "schema_constraints,schema_traversals,"
+            << "validation_adapter_find_calls,"
+            << "validation_adapter_find_scans,"
+            << "validation_adapter_members,"
+            << "validation_adapter_constructions,"
+            << "validation_string_copies,validation_string_bytes,"
+            << "validation_index_builds,validation_index_members,"
+            << "validation_constraints,validation_traversals,"
+            << "validation_allof,validation_anyof,validation_oneof,"
+            << "validation_properties,validation_required,"
+            << "validation_items,validation_types,"
+            << "validation_unique_items,"
+            << "validation_unique_comparisons,"
+            << "validation_unique_scalar_values,"
+            << "typed_find_calls,typed_find_scans,status\n";
+
+        for (const auto& row : rows)
+        {
+            const auto& schema = Domain(
+                row,
+                Internal::T39Domain::SchemaPopulation);
+            const auto& validation = Domain(
+                row,
+                Internal::T39Domain::Validation);
+            const auto& typed = Domain(
+                row,
+                Internal::T39Domain::TypedConstruction);
+
+            output
+                << EscapeCsv(row.variant) << ','
+                << EscapeCsv(row.caseId) << ','
+                << row.sample << ','
+                << (row.warmup ? "true" : "false") << ','
+                << row.totalLoadUs << ','
+                << row.fileJsonUs << ','
+                << row.fileOpenUs << ','
+                << row.jsonChunkUs << ','
+                << row.strictParseUs << ','
+                << row.validationDomUs << ','
+                << row.schemaCompileUs << ','
+                << Phase(row, Internal::T39Phase::SchemaLocate) << ','
+                << Phase(row, Internal::T39Phase::SchemaParse) << ','
+                << Phase(row, Internal::T39Phase::SchemaPopulate) << ','
+                << row.validateUs << ','
+                << row.typedUs << ','
+                << row.resourcesUs << ','
+                << Phase(row, Internal::T39Phase::Accessors) << ','
+                << Phase(row, Internal::T39Phase::Animations) << ','
+                << Phase(row, Internal::T39Phase::Buffers) << ','
+                << Phase(row, Internal::T39Phase::BufferViews) << ','
+                << Phase(row, Internal::T39Phase::Cameras) << ','
+                << Phase(row, Internal::T39Phase::Images) << ','
+                << Phase(row, Internal::T39Phase::Materials) << ','
+                << Phase(row, Internal::T39Phase::Meshes) << ','
+                << Phase(row, Internal::T39Phase::Nodes) << ','
+                << Phase(row, Internal::T39Phase::Samplers) << ','
+                << Phase(row, Internal::T39Phase::Scenes) << ','
+                << Phase(row, Internal::T39Phase::Skins) << ','
+                << Phase(row, Internal::T39Phase::Textures) << ','
+                << Phase(row, Internal::T39Phase::TypedOther) << ','
+                << row.serializerDomUs << ','
+                << row.serializerTextUs << ','
+                << row.resourceWriteUs << ','
+                << row.cacheSetupUs << ','
+                << row.inputBytes << ','
+                << row.jsonBytes << ','
+                << row.resourceBytes << ','
+                << row.bufferReadUs << ','
+                << row.imageReadUs << ','
+                << row.bufferBytes << ','
+                << row.imageBytes;
+            WriteMemory(output, row.afterInput);
+            WriteMemory(output, row.afterParse);
+            WriteMemory(output, row.afterValidationDom);
+            WriteMemory(output, row.afterSchema);
+            WriteMemory(output, row.afterValidation);
+            WriteMemory(output, row.afterTyped);
+            WriteMemory(output, row.afterResources);
+            WriteMemory(output, row.afterSerialization);
+            output
+                << ',' << row.profile.schemaLocatorCalls
+                << ',' << row.profile.schemaDocumentsParsed
+                << ',' << row.profile.schemaBytesParsed
+                << ',' << row.profile.parserParentScanLoops
+                << ',' << row.profile.parserParentScanElements
+                << ',' << schema.adapterFindCalls
+                << ',' << schema.adapterFindScans
+                << ',' << schema.adapterMemberDereferences
+                << ',' << schema.adapterConstructions
+                << ',' << schema.constraintEvaluations
+                << ',' << schema.validationSchemaCalls
+                << ',' << validation.adapterFindCalls
+                << ',' << validation.adapterFindScans
+                << ',' << validation.adapterMemberDereferences
+                << ',' << validation.adapterConstructions
+                << ',' << validation.adapterStringCopies
+                << ',' << validation.adapterStringBytes
+                << ',' << validation.adapterIndexBuilds
+                << ',' << validation.adapterIndexMembers
+                << ',' << validation.constraintEvaluations
+                << ',' << validation.validationSchemaCalls
+                << ',' << validation.allOfEvaluations
+                << ',' << validation.anyOfEvaluations
+                << ',' << validation.oneOfEvaluations
+                << ',' << validation.propertiesEvaluations
+                << ',' << validation.requiredEvaluations
+                << ',' << validation.itemsEvaluations
+                << ',' << validation.typeEvaluations
+                << ',' << validation.uniqueItemsEvaluations
+                << ',' << validation.uniqueItemComparisons
+                << ',' << validation.uniqueScalarValues
+                << ',' << typed.jsonFindCalls
+                << ',' << typed.jsonFindScans
+                << ',' << EscapeCsv(row.status)
+                << '\n';
+        }
+    }
+}
+
+int main(int argc, char** argv)
+{
+    try
+    {
+        const auto options = ParseOptions(argc, argv);
+        const auto asset = GetAssetCase(options.caseId);
+        const auto rows = RunVariant(options, asset);
+        WriteRows(options, rows);
+        std::cout
+            << "Wrote " << rows.size()
+            << " samples for " << options.variant
+            << "/" << options.caseId
+            << "; sink=" << g_sink << std::endl;
+        return 0;
+    }
+    catch (const std::exception& exception)
+    {
+        std::cerr
+            << "Node performance investigation failure: "
+            << exception.what() << std::endl;
+        return 1;
+    }
+}
