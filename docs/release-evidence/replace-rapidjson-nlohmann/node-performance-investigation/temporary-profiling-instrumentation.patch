+
+                return &g_t39ProfileState->counters[
+                    static_cast<std::size_t>(
+                        g_t39ProfileState->domain)];
+            }
+
+            inline void T39CountJsonFind(std::uint64_t scans)
+            {
+                auto* counters = T39ActiveCounters();
