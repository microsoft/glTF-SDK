+        std::string variant;
+        std::string caseId;
+        std::size_t sample = 0U;
+        bool warmup = false;
+        double totalLoadUs = 0.0;
+        double fileJsonUs = 0.0;
+        double fileOpenUs = 0.0;
+        double jsonChunkUs = 0.0;
+        double strictParseUs = 0.0;
+        double validationDomUs = 0.0;
+        double schemaCompileUs = 0.0;
+        double validateUs = 0.0;
+        double typedUs = 0.0;
+        double resourcesUs = 0.0;
+        double bufferReadUs = 0.0;
+        double imageReadUs = 0.0;
+        double serializerDomUs = 0.0;
