+            enum class T39Domain : std::size_t
+            {
+                None,
+                SchemaPopulation,
+                Validation,
+                TypedConstruction,
+                Serialization,
+                Count
+            };
+
+            enum class T39Phase : std::size_t
+            {
+                SchemaValidation,
+                SchemaLocate,
+                SchemaParse,
+                SchemaPopulate,
+                DocumentValidate,
+                TypedConstruction,
+                Accessors,
+                Animations,
+                Buffers,
+                BufferViews,
+                Cameras,
+                Images,
+                Materials,
+                Meshes,
+                Nodes,
+                Samplers,
+                Scenes,
+                Skins,
+                Textures,
+                TypedOther,
+                SerializerDom,
+                SerializerText,
+                Count
+            };
+
+            struct T39DomainCounters
+            {
+                std::uint64_t jsonFindCalls = 0U;
+                std::uint64_t jsonFindScans = 0U;
+                std::uint64_t adapterFindCalls = 0U;
+                std::uint64_t adapterFindScans = 0U;
+                std::uint64_t adapterMemberDereferences = 0U;
+                std::uint64_t adapterConstructions = 0U;
+                std::uint64_t adapterStringCopies = 0U;
+                std::uint64_t adapterStringBytes = 0U;
+                std::uint64_t adapterIndexBuilds = 0U;
+                std::uint64_t adapterIndexMembers = 0U;
+                std::uint64_t validationSchemaCalls = 0U;
+                std::uint64_t constraintEvaluations = 0U;
+                std::uint64_t allOfEvaluations = 0U;
+                std::uint64_t anyOfEvaluations = 0U;
+                std::uint64_t oneOfEvaluations = 0U;
+                std::uint64_t propertiesEvaluations = 0U;
+                std::uint64_t requiredEvaluations = 0U;
+                std::uint64_t itemsEvaluations = 0U;
+                std::uint64_t typeEvaluations = 0U;
+                std::uint64_t uniqueItemsEvaluations = 0U;
+                std::uint64_t uniqueItemComparisons = 0U;
+                std::uint64_t uniqueScalarValues = 0U;
+            };
+
+            struct T39ProfileState
+            {
+                bool recordTimings = true;
+                bool countOperations = false;
+                bool optimizeScalarUniqueItems = false;
+                T39Domain domain = T39Domain::None;
+                std::array<double, static_cast<std::size_t>(T39Phase::Count)>
+                    phaseMicroseconds{};
+                std::array<T39DomainCounters,
+                    static_cast<std::size_t>(T39Domain::Count)> counters{};
+                std::uint64_t schemaLocatorCalls = 0U;
+                std::uint64_t schemaDocumentsParsed = 0U;
+                std::uint64_t schemaBytesParsed = 0U;
+                std::uint64_t parserParentScanLoops = 0U;
+                std::uint64_t parserParentScanElements = 0U;
+            };
+
+            extern thread_local T39ProfileState* g_t39ProfileState;
+
+            void T39RecordCallbackParentScan(std::size_t elements);
+
+            class T39ProfileScope
+            {
+            public:
+                explicit T39ProfileScope(T39ProfileState& state)
+                    : m_previous(g_t39ProfileState)
+                {
+                    g_t39ProfileState = &state;
+                }
+
+                ~T39ProfileScope()
+                {
+                    g_t39ProfileState = m_previous;
+                }
+
+            private:
+                T39ProfileState* m_previous;
+            };
+
+            class T39DomainScope
+            {
+            public:
+                explicit T39DomainScope(T39Domain domain)
+                    : m_state(g_t39ProfileState),
+                      m_previous(m_state == nullptr
+                          ? T39Domain::None
+                          : m_state->domain)
+                {
+                    if (m_state != nullptr)
+                    {
+                        m_state->domain = domain;
+                    }
+                }
+
+                ~T39DomainScope()
+                {
+                    if (m_state != nullptr)
+                    {
+                        m_state->domain = m_previous;
+                    }
+                }
+
+            private:
+                T39ProfileState* m_state;
+                T39Domain m_previous;
+            };
+
+            class T39PhaseScope
+            {
+            public:
+                explicit T39PhaseScope(T39Phase phase)
+                    : m_state(g_t39ProfileState),
+                      m_phase(phase),
+                      m_start()
+                {
+                    if (m_state != nullptr && m_state->recordTimings)
+                    {
+                        m_start = std::chrono::steady_clock::now();
+                    }
+                }
+
+                ~T39PhaseScope()
+                {
+                    if (m_state != nullptr && m_state->recordTimings)
+                    {
+                        const auto elapsed =
+                            std::chrono::duration<double, std::micro>(
+                                std::chrono::steady_clock::now() - m_start)
+                                .count();
+                        m_state->phaseMicroseconds[
+                            static_cast<std::size_t>(m_phase)] += elapsed;
+                    }
+                }
+
+            private:
+                T39ProfileState* m_state;
+                T39Phase m_phase;
+                std::chrono::steady_clock::time_point m_start;
+            };
+
+            inline T39DomainCounters* T39ActiveCounters()
+            {
+                if (g_t39ProfileState == nullptr ||
