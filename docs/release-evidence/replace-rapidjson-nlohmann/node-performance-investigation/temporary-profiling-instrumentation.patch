+    };
+
+    struct LoadedInput
+    {
+        std::shared_ptr<class FileStreamReader> streamReader;
+        std::shared_ptr<std::istream> sourceStream;
+        std::unique_ptr<GLBResourceReader> resourceReader;
+        std::uint64_t sourceBytes = 0U;
+    };
+
+    struct LoadedResources
+    {
+        std::vector<std::vector<std::uint8_t>> buffers;
+        std::vector<std::vector<std::uint8_t>> images;
+        std::uint64_t bytes = 0U;
+        std::uint64_t bufferBytes = 0U;
+        std::uint64_t imageBytes = 0U;
+    };
+
+    class StrictOrderedSax final :
+        public nlohmann::json_sax<OrderedJson>
+    {
+    public:
+        using string_t = OrderedJson::string_t;
+        using binary_t = OrderedJson::binary_t;
+        using number_integer_t = OrderedJson::number_integer_t;
+        using number_unsigned_t = OrderedJson::number_unsigned_t;
+        using number_float_t = OrderedJson::number_float_t;
+
+        bool null() override
+        {
+            AddValue(OrderedJson(nullptr));
+            return true;
+        }
+
+        bool boolean(bool value) override
+        {
+            AddValue(OrderedJson(value));
+            return true;
+        }
+
+        bool number_integer(number_integer_t value) override
+        {
+            AddValue(OrderedJson(value));
+            return true;
+        }
+
+        bool number_unsigned(number_unsigned_t value) override
+        {
+            AddValue(OrderedJson(value));
+            return true;
+        }
+
+        bool number_float(
+            number_float_t value,
+            const string_t&) override
+        {
+            AddValue(OrderedJson(value));
+            return true;
+        }
+
+        bool string(string_t& value) override
+        {
+            AddValue(OrderedJson(std::move(value)));
+            return true;
+        }
+
+        bool binary(binary_t& value) override
+        {
+            AddValue(OrderedJson(std::move(value)));
+            return true;
+        }
+
+        bool start_object(std::size_t) override
+        {
+            CheckDepth();
+            OrderedJson* object =
+                AddValue(OrderedJson::object());
+            m_frames.push_back(Frame{object, true, {}, {}});
+            return true;
+        }
+
+        bool key(string_t& value) override
+        {
+            if (m_frames.empty() ||
+                !m_frames.back().object)
+            {
+                throw GLTFException(
+                    "The document is invalid due to bad JSON formatting");
+            }
+            if (!m_frames.back().keys.insert(value).second)
+            {
+                throw GLTFException(
+                    "The document contains a duplicate object member: " +
+                    value);
+            }
+            m_frames.back().key = std::move(value);
+            return true;
+        }
+
+        bool end_object() override
+        {
+            m_frames.pop_back();
+            return true;
+        }
+
+        bool start_array(std::size_t) override
+        {
+            CheckDepth();
+            OrderedJson* array =
+                AddValue(OrderedJson::array());
+            m_frames.push_back(Frame{array, false, {}, {}});
+            return true;
+        }
+
+        bool end_array() override
+        {
+            m_frames.pop_back();
+            return true;
+        }
+
+        bool parse_error(
+            std::size_t,
+            const std::string&,
+            const nlohmann::detail::exception&) override
+        {
+            m_parseError = true;
+            return false;
+        }
+
+        OrderedJson TakeResult()
+        {
+            if (m_parseError || !m_frames.empty())
+            {
+                throw GLTFException(
+                    "The document is invalid due to bad JSON formatting");
+            }
+            return std::move(m_result);
+        }
+
+    private:
+        struct Frame
+        {
+            OrderedJson* value;
+            bool object;
+            std::string key;
+            std::unordered_set<std::string> keys;
+        };
+
+        void CheckDepth() const
+        {
+            if (m_frames.size() + 1U >
+                Internal::MaxJsonNestingDepth)
+            {
+                throw GLTFException(
+                    "The document exceeds the maximum JSON nesting depth "
+                    "of 256");
+            }
+        }
+
+        OrderedJson* AddValue(OrderedJson value)
+        {
+            if (m_frames.empty())
+            {
+                m_result = std::move(value);
+                return &m_result;
+            }
+
+            Frame& frame = m_frames.back();
+            if (frame.object)
+            {
+                OrderedJson& inserted =
+                    (*frame.value)[frame.key];
+                inserted = std::move(value);
+                return &inserted;
+            }
+
+            frame.value->push_back(std::move(value));
+            return &frame.value->back();
+        }
+
+        OrderedJson m_result;
+        std::vector<Frame> m_frames;
+        bool m_parseError = false;
+    };
+
+    bool StartsWithUnsupportedBom(const std::string& bytes)
+    {
+        if (bytes.size() >= 4U)
+        {
+            const auto first =
+                static_cast<unsigned char>(bytes[0]);
+            const auto second =
+                static_cast<unsigned char>(bytes[1]);
+            const auto third =
+                static_cast<unsigned char>(bytes[2]);
+            const auto fourth =
+                static_cast<unsigned char>(bytes[3]);
+            if ((first == 0x00U && second == 0x00U &&
+                 third == 0xFEU && fourth == 0xFFU) ||
+                (first == 0xFFU && second == 0xFEU &&
+                 third == 0x00U && fourth == 0x00U))
+            {
+                return true;
+            }
+        }
+        return bytes.size() >= 2U &&
+            ((static_cast<unsigned char>(bytes[0]) == 0xFEU &&
+              static_cast<unsigned char>(bytes[1]) == 0xFFU) ||
+             (static_cast<unsigned char>(bytes[0]) == 0xFFU &&
+              static_cast<unsigned char>(bytes[1]) == 0xFEU));
+    }
+
+    OrderedJson ParseOrdered(
+        const std::string& bytes,
+        ParseMode mode)
+    {
+        if (mode == ParseMode::CallbackStrict)
+        {
+            return Internal::ParseJson(bytes);
+        }
+        if (mode == ParseMode::Plain)
+        {
+            return OrderedJson::parse(
+                bytes.begin(),
+                bytes.end(),
+                nullptr,
+                true,
+                false);
+        }
+
+        if (StartsWithUnsupportedBom(bytes))
+        {
+            throw GLTFException(
+                "The document is not UTF-8 JSON");
+        }
+        if (bytes.size() >= 3U &&
+            static_cast<unsigned char>(bytes[0]) == 0xEFU &&
+            static_cast<unsigned char>(bytes[1]) == 0xBBU &&
+            static_cast<unsigned char>(bytes[2]) == 0xBFU)
+        {
+            throw GLTFException(
+                "The document contains a UTF-8 byte order mark");
+        }
+
+        StrictOrderedSax sax;
+        if (!OrderedJson::sax_parse(
+                bytes.begin(),
+                bytes.end(),
+                &sax,
+                nlohmann::json::input_format_t::json,
+                true,
+                false))
+        {
+            throw GLTFException(
+                "The document is invalid due to bad JSON formatting");
+        }
+        return sax.TakeResult();
+    }
+
+    template<typename Json>
+    struct SchemaProvider
+    {
+        explicit SchemaProvider(bool disableRoot)
+            : disableRoot(disableRoot)
+        {
+        }
+
+        const Json* GetDocument(const std::string& uri)
+        {
+            const auto existing = documents.find(uri);
+            if (existing != documents.end())
+            {
+                return existing->second.get();
+            }
+
+            Internal::T39PhaseScope locate(
+                Internal::T39Phase::SchemaLocate);
+            if (Internal::g_t39ProfileState != nullptr)
+            {
+                ++Internal::g_t39ProfileState->schemaLocatorCalls;
+            }
+
+            std::string content;
+            if (disableRoot && uri == SCHEMA_URI_GLTF)
+            {
+                content = "{}";
+            }
+            else
+            {
+                const auto& schemas = GetDefaultSchemaUriMap();
+                const auto schema = schemas.find(uri);
+                if (schema == schemas.end())
+                {
+                    throw std::runtime_error(
+                        "Unable to locate schema " + uri);
+                }
+                content = schema->second;
+            }
+
+            std::unique_ptr<Json> parsed;
+            {
+                Internal::T39PhaseScope parse(
+                    Internal::T39Phase::SchemaParse);
+                if (Internal::g_t39ProfileState != nullptr)
+                {
+                    ++Internal::g_t39ProfileState->
+                        schemaDocumentsParsed;
+                    Internal::g_t39ProfileState->
+                        schemaBytesParsed += content.size();
+                }
+                parsed.reset(new Json(Parse(content)));
+            }
+
+            const Json* result = parsed.get();
+            documents.emplace(uri, std::move(parsed));
+            return result;
+        }
+
+        static Json Parse(const std::string& content)
+        {
+            return Json::parse(
+                content.begin(),
+                content.end(),
+                nullptr,
+                true,
+                false);
+        }
+
+        bool disableRoot;
+        std::unordered_map<std::string, std::unique_ptr<Json>>
+            documents;
+    };
+
+    template<>
+    OrderedJson SchemaProvider<OrderedJson>::Parse(
+        const std::string& content)
+    {
+        return Internal::ParseJson(content);
+    }
+
+    template<typename Json, typename Adapter>
+    struct CompiledSchema
+    {
+        explicit CompiledSchema(bool disableRoot)
+            : provider(new SchemaProvider<Json>(disableRoot))
+        {
+        }
+
+        std::unique_ptr<SchemaProvider<Json>> provider;
+        valijson::Schema schema;
+    };
