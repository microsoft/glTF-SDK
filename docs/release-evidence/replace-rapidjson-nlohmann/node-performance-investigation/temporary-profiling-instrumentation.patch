+/**
+ * @brief  Light weight wrapper for a T39IndexedJson array value.
+ *
+ * This class is light weight wrapper for a T39IndexedJson array. It provides a
+ * minimum set of container functions and typedefs that allow it to be used as
+ * an iterable container.
+ *
+ * An instance of this class contains a single reference to the underlying
+ * T39IndexedJson value, assumed to be an array, so there is very little overhead
+ * associated with copy construction and passing by value.
+ */
+template <class ValueType>
+class T39IndexedJsonArray
+{
+public:
+
+    typedef T39IndexedJsonArrayValueIterator<ValueType> const_iterator;
+    typedef T39IndexedJsonArrayValueIterator<ValueType> iterator;
+
+    /// Construct a T39IndexedJsonArray referencing an empty array.
+    T39IndexedJsonArray()
+      : m_value(emptyArray()) { }
+
+    /**
+     * @brief   Construct a T39IndexedJsonArray referencing a specific T39IndexedJson
+     *          value.
+     *
+     * @param   value   reference to a T39IndexedJson value
+     *
+     * Note that this constructor will throw an exception if the value is not
+     * an array.
+     */
+    T39IndexedJsonArray(const T39IndexedJson &value)
+      : m_value(value)
+    {
+        if (!value.is_array()) {
+            throwRuntimeError("Value is not an array.");
+        }
+    }
+
+    /**
+     * @brief   Return an iterator for the first element of the array.
+     *
+     * The iterator return by this function is effectively the iterator
+     * returned by the underlying T39IndexedJson implementation.
+     */
+    T39IndexedJsonArrayValueIterator<ValueType> begin() const {
+      return m_value.begin();
+    }
+
+
+    /**
+     * @brief   Return an iterator for one-past the last element of the array.
+     *
+     * The iterator return by this function is effectively the iterator
+     * returned by the underlying T39IndexedJson implementation.
+     */
+    T39IndexedJsonArrayValueIterator<ValueType> end() const {
+      return m_value.end();
+    }
+
+    /// Return the number of elements in the array
+    size_t size() const
+    {
+        return m_value.size();
+    }
+
+private:
+
+    /**
+     * @brief   Return a reference to a T39IndexedJson value that is an empty array.
+     *
+     * Note that the value returned by this function is a singleton.
+     */
+    static const T39IndexedJson & emptyArray()
+    {
+        static const T39IndexedJson array = T39IndexedJson::array();
+        return array;
+    }
+
+    /// Reference to the contained value
+    const T39IndexedJson &m_value;
+};
+
+/**
+ * @brief  Light weight wrapper for a T39IndexedJson object.
+ *
+ * This class is light weight wrapper for a T39IndexedJson object. It provides a
+ * minimum set of container functions and typedefs that allow it to be used as
+ * an iterable container.
+ *
+ * An instance of this class contains a single reference to the underlying
+ * T39IndexedJson value, assumed to be an object, so there is very little overhead
+ * associated with copy construction and passing by value.
+ */
+class T39IndexedJsonObject
+{
+public:
+
+    typedef T39IndexedJsonObjectMemberIterator<T39IndexedJsonObjectMember> const_iterator;
+    typedef T39IndexedJsonObjectMemberIterator<T39IndexedJsonObjectMember> iterator;
+
+    /// Construct a T39IndexedJsonObject referencing an empty object singleton.
+    T39IndexedJsonObject()
+      : m_value(emptyObject()),
+        m_index(buildIndex(m_value)) { }
+
+    /**
+     * @brief   Construct a T39IndexedJsonObject referencing a specific T39IndexedJson
+     *          value.
+     *
+     * @param   value  reference to a T39IndexedJson value
+     *
+     * Note that this constructor will throw an exception if the value is not
+     * an object.
+     */
+    T39IndexedJsonObject(const T39IndexedJson &value)
+      : m_value(value),
+        m_index(buildIndex(m_value))
+    {
+        if (!value.is_object()) {
+            throwRuntimeError("Value is not an object.");
+        }
+    }
+
+    /**
+     * @brief   Return an iterator for this first object member
+     *
+     * The iterator return by this function is effectively a wrapper around
+     * the iterator value returned by the underlying T39IndexedJson implementation.
+     */
+    T39IndexedJsonObjectMemberIterator<T39IndexedJsonObjectMember> begin() const;
+
+    /**
+     * @brief   Return an iterator for an invalid object member that indicates
+     *          the end of the collection.
+     *
+     * The iterator return by this function is effectively a wrapper around
+     * the iterator value returned by the underlying T39IndexedJson implementation.
+     */
+    T39IndexedJsonObjectMemberIterator<T39IndexedJsonObjectMember> end() const;
+
+    /**
+     * @brief   Return an iterator for the object member with the specified
+     *          property name.
+     *
+     * If an object member with the specified name does not exist, the iterator
+     * returned will be the same as the iterator returned by the end() function.
+     *
+     * @param   propertyName  property name to search for
+     */
+    T39IndexedJsonObjectMemberIterator<T39IndexedJsonObjectMember>
+    find(const std::string &propertyName) const;
+
+    /// Returns the number of members belonging to this object.
+    size_t size() const
+    {
+        return m_value.size();
+    }
+
+private:
+    using NativeIterator = T39IndexedJson::const_iterator;
+    using Index = std::unordered_map<std::string, NativeIterator>;
+
+    static std::shared_ptr<const Index> buildIndex(
+        const T39IndexedJson &value)
+    {
+        auto index = std::make_shared<Index>();
+        index->reserve(value.size());
+        for (auto iterator = value.begin();
+             iterator != value.end();
+             ++iterator) {
+            index->emplace(iterator.key(), iterator);
+        }
+        Microsoft::glTF::Internal::T39CountAdapterIndexBuild(
+            value.size());
+        return index;
+    }
+
+    /**
+     * @brief   Return a reference to a T39IndexedJson value that is empty object.
+     *
+     * Note that the value returned by this function is a singleton.
+     */
+    static const T39IndexedJson & emptyObject()
+    {
+        static const T39IndexedJson object = T39IndexedJson::object();
+        return object;
+    }
+
+    /// Reference to the contained object
+    const T39IndexedJson &m_value;
+    std::shared_ptr<const Index> m_index;
+};
+
+
+/**
+ * @brief   Stores an independent copy of a T39IndexedJson value.
+ *
+ * This class allows a T39IndexedJson value to be stored independent of its original
+ * document. T39IndexedJson makes this easy to do, as it does not perform any
+ * custom memory management.
+ *
+ * @see FrozenValue
+ */
+class T39IndexedJsonFrozenValue: public FrozenValue
+{
+public:
+
+    /**
+     * @brief  Make a copy of a T39IndexedJson value
+     *
+     * @param  source  the T39IndexedJson value to be copied
+     */
+    explicit T39IndexedJsonFrozenValue(T39IndexedJson source)
+      : m_value(std::move(source)) { }
+
+    FrozenValue * clone() const override
+    {
+        return new T39IndexedJsonFrozenValue(m_value);
+    }
+
+    bool equalTo(const Adapter &other, bool strict) const override;
+
+private:
+
+    /// Stored T39IndexedJson value
+    T39IndexedJson m_value;
+};
+
+
+/**
+ * @brief   Light weight wrapper for a T39IndexedJson value.
+ *
+ * This class is passed as an argument to the BasicAdapter template class,
+ * and is used to provide access to a T39IndexedJson value. This class is responsible
+ * for the mechanics of actually reading a T39IndexedJson value, whereas the
+ * BasicAdapter class is responsible for the semantics of type comparisons
+ * and conversions.
+ *
+ * The functions that need to be provided by this class are defined implicitly
+ * by the implementation of the BasicAdapter template class.
+ *
+ * @see BasicAdapter
+ */
+template<class ValueType>
+class T39IndexedJsonValue
+{
+public:
+
+    /// Construct a wrapper for the empty object singleton
+    T39IndexedJsonValue()
+      : m_value(emptyObject()) { }
+
+    /// Construct a wrapper for a specific T39IndexedJson value
+    T39IndexedJsonValue(const T39IndexedJson &value)
+      : m_value(value) { }
+
+    /**
+     * @brief   Create a new T39IndexedJsonFrozenValue instance that contains the
+     *          value referenced by this T39IndexedJsonValue instance.
+     *
+     * @returns pointer to a new T39IndexedJsonFrozenValue instance, belonging to the
+     *          caller.
+     */
+    FrozenValue * freeze() const
+    {
+        return new T39IndexedJsonFrozenValue(m_value);
+    }
+
+    /**
+     * @brief   Optionally return a T39IndexedJsonArray instance.
+     *
+     * If the referenced T39IndexedJson value is an array, this function will return
+     * a std::optional containing a T39IndexedJsonArray instance referencing the
+     * array.
+     *
+     * Otherwise it will return an empty optional.
+     */
+    opt::optional<T39IndexedJsonArray<ValueType>> getArrayOptional() const
+    {
+        if (m_value.is_array()) {
+            return opt::make_optional(T39IndexedJsonArray<ValueType>(m_value));
+        }
+
+        return {};
+    }
+
+    /**
+     * @brief   Retrieve the number of elements in the array
+     *
+     * If the referenced T39IndexedJson value is an array, this function will
+     * retrieve the number of elements in the array and store it in the output
+     * variable provided.
+     *
+     * @param   result  reference to size_t to set with result
+     *
+     * @returns true if the number of elements was retrieved, false otherwise.
+     */
+    bool getArraySize(size_t &result) const
+    {
+        if (m_value.is_array()) {
+            result = m_value.size();
+            return true;
+        }
+
+        return false;
+    }
+
+    bool getBool(bool &result) const
+    {
+        if (m_value.is_boolean()) {
+            result = m_value.get<bool>();
+            return true;
+        }
+
+        return false;
+    }
+
+    bool getDouble(double &result) const
+    {
+        if (m_value.is_number_float()) {
+            result = m_value.get<double>();
+            return true;
+        }
+
+        return false;
+    }
+
+    bool getInteger(int64_t &result) const
+    {
+        if(m_value.is_number_integer()) {
+            result = m_value.get<int64_t>();
+            return true;
+        }
+        return false;
+    }
+
+    /**
+     * @brief   Optionally return a T39IndexedJsonObject instance.
+     *
+     * If the referenced T39IndexedJson value is an object, this function will return a
+     * std::optional containing a T39IndexedJsonObject instance referencing the
+     * object.
+     *
+     * Otherwise it will return an empty optional.
+     */
+    opt::optional<T39IndexedJsonObject> getObjectOptional() const;
+
+    /**
+     * @brief   Retrieve the number of members in the object
+     *
+     * If the referenced T39IndexedJson value is an object, this function will
+     * retrieve the number of members in the object and store it in the output
+     * variable provided.
+     *
+     * @param   result  reference to size_t to set with result
+     *
+     * @returns true if the number of members was retrieved, false otherwise.
+     */
+    bool getObjectSize(size_t &result) const
+    {
+        if (m_value.is_object()) {
+            result = m_value.size();
+            return true;
+        }
+
+        return false;
+    }
+
+    bool getString(std::string &result) const
+    {
+        if (m_value.is_string()) {
+            result = m_value.get<std::string>();
+            Microsoft::glTF::Internal::T39CountAdapterStringCopy(
+                result.size());
+            return true;
+        }
+
+        return false;
+    }
+
+    static bool hasStrictTypes()
+    {
+        return true;
+    }
+
+    bool isArray() const
+    {
+        return m_value.is_array();
+    }
+
+    bool isBool() const
+    {
+        return m_value.is_boolean();
+    }
+
+    bool isDouble() const
+    {
+        return m_value.is_number_float();
+    }
+
+    bool isInteger() const
+    {
+        return m_value.is_number_integer();
+    }
+
+    bool isNull() const
+    {
+        return m_value.is_null();
+    }
+
+    bool isNumber() const
+    {
+        return m_value.is_number();
+    }
+
+    bool isObject() const
+    {
+        return m_value.is_object();
+    }
+
+    bool isString() const
+    {
+        return m_value.is_string();
+    }
+
+private:
+
+    /// Return a reference to an empty object singleton
+    static const T39IndexedJson & emptyObject()
+    {
+        static const T39IndexedJson object = T39IndexedJson::object();
+        return object;
+    }
+
+    /// Reference to the contained T39IndexedJson value.
+    const T39IndexedJson &m_value;
+};
+
+/**
+ * @brief   An implementation of the Adapter interface supporting T39IndexedJson.
+ *
+ * This class is defined in terms of the BasicAdapter template class, which
+ * helps to ensure that all of the Adapter implementations behave consistently.
+ *
+ * @see Adapter
+ * @see BasicAdapter
+ */
+class T39IndexedJsonAdapter
+    : public BasicAdapter<T39IndexedJsonAdapter,
+                          T39IndexedJsonArray<T39IndexedJsonAdapter>,
+                          T39IndexedJsonObjectMember, T39IndexedJsonObject,
+                          T39IndexedJsonValue<T39IndexedJsonAdapter>>
+{
+public:
+    /// Construct a T39IndexedJsonAdapter that contains an empty object
+    T39IndexedJsonAdapter()
+      : BasicAdapter() { }
+
+    /// Construct a T39IndexedJsonAdapter containing a specific Nlohmann Json
+    /// object
+    T39IndexedJsonAdapter(const T39IndexedJson &value)
+        : BasicAdapter(T39IndexedJsonValue<T39IndexedJsonAdapter>{value})
+    {
+        Microsoft::glTF::Internal::T39CountAdapterConstruction();
+    }
+};
+
+template <class ValueType>
+opt::optional<T39IndexedJsonObject>
+T39IndexedJsonValue<ValueType>::getObjectOptional() const
+{
+    if (m_value.is_object()) {
+        return opt::make_optional(T39IndexedJsonObject(m_value));
+    }
+
+    return {};
+}
+
+/// Specialisation of the AdapterTraits template struct for T39IndexedJsonAdapter.
+template<>
+struct AdapterTraits<valijson::adapters::T39IndexedJsonAdapter>
+{
+    typedef T39IndexedJson DocumentType;
+
+    static std::string adapterName()
+    {
+        return "T39IndexedJsonAdapter";
+    }
+};
+
+inline bool T39IndexedJsonFrozenValue::equalTo(const Adapter &other, bool strict) const
+{
+    return T39IndexedJsonAdapter(m_value).equalTo(other, strict);
+}
+
+
+inline T39IndexedJsonObjectMemberIterator<T39IndexedJsonObjectMember>
+T39IndexedJsonObject::begin() const
+{
+    return m_value.begin();
+}
+
+inline T39IndexedJsonObjectMemberIterator<T39IndexedJsonObjectMember>
+T39IndexedJsonObject::end() const
+{
+    return m_value.end();
+}
+
+inline T39IndexedJsonObjectMemberIterator<T39IndexedJsonObjectMember>
+T39IndexedJsonObject::find(
+        const std::string &propertyName) const
+{
+    const auto found = m_index->find(propertyName);
+    Microsoft::glTF::Internal::T39CountAdapterFind(
+        found == m_index->end() ? 0U : 1U);
+    return found == m_index->end()
+        ? m_value.end()
+        : found->second;
+}
+
+}  // namespace adapters
+}  // namespace valijson
